# RecurScope Frontend Environment Variables
# ---------------------------------------------
# 1. Operational Backend (Production Pilot):
# Connects genuine residents, field staff, and supervisors to live database records.
# When served on localhost, defaults to http://127.0.0.1:8018 if unset.
# In production cross-domain hosting (e.g. Vercel frontend + Render backend):
VITE_API_BASE_URL=https://your-recurscope-api.onrender.com

# 2. Isolated Demo Backend (Explore Demo Sandbox):
# Connects demo role cards to an isolated test environment with synthetic seed records.
# Must point to a separate demo service (ENVIRONMENT=development, SEED_DEMO=true, separate DB).
# In production, if unset, demo mode is disabled and shows an incomplete configuration notice.
VITE_DEMO_API_BASE_URL=https://your-recurscope-demo-api.onrender.com
