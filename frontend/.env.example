# RecurScope Frontend Environment Variables
# If omitted or empty, the frontend connects to:
# - http://127.0.0.1:8018 when running on localhost / 127.0.0.1
# - window.location.origin (relative /api requests) when served behind a reverse proxy (e.g. Docker / Nginx / Render)
# For cross-domain hosting (e.g., Vercel frontend + Render backend), set the backend origin:
VITE_API_BASE_URL=http://localhost:8018
