# Environment Mode: 'development' or 'production'
ENVIRONMENT=development

# Database: SQLite for local demo; PostgreSQL for persistent production deployment
DATABASE_URL=sqlite:///./recurscope.db

# JWT Security: generate with `openssl rand -hex 32` or `python -c "import secrets; print(secrets.token_hex(32))"`
SECRET_KEY=replace-with-a-long-random-secret-before-deployment
ACCESS_TOKEN_EXPIRE_HOURS=8

# Demo protection: set to false in production to prevent accidental reset of live data
ALLOW_DEMO_RESET=false

# Storage: local path or mounted persistent volume mountpoint
EVIDENCE_DIR=./storage/evidence

# CORS: Comma-separated list of allowed frontend origins, or '*' for public demo
CORS_ORIGINS=http://localhost:5188,http://127.0.0.1:5188
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app

MAX_UPLOAD_MB=5
HOTSPOT_RADIUS_METERS=100

# Explainable operational-priority score (initial hypotheses, not a trained model)
SCORE_WEIGHT_VERIFIED_RETURNS=30
SCORE_WEIGHT_INCIDENT_FREQUENCY=20
SCORE_WEIGHT_OVERDUE_PICKUP=15
SCORE_WEIGHT_SEVERITY=15
SCORE_WEIGHT_TIME_TO_RETURN=15
SCORE_WEIGHT_HANDOFF_GAP=5
SCORE_POINTS_PER_RETURN=15
SCORE_POINTS_PER_EXTRA_REPORT=5
PRIORITY_MONITOR_THRESHOLD=35
PRIORITY_HIGH_THRESHOLD=60
PRIORITY_CRITICAL_THRESHOLD=80
